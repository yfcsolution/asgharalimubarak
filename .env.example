# Local development
WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/asgharalimubarakblog.wordpress.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (Vercel) — set these in the Vercel project Environment Variables:
# WORDPRESS_API_URL=https://public-api.wordpress.com/wp/v2/sites/asgharalimubarakblog.wordpress.com
# NEXT_PUBLIC_SITE_URL=https://asgharalimubarak.com

# Content snapshot fallback (filesystem is local-dev only; use KV/Blob/Postgres in production)
CONTENT_SNAPSHOT_STORAGE=filesystem
CONTENT_SNAPSHOT_PATH=.content-cache

# Recommendations (client-side localStorage fallback)
NEXT_PUBLIC_RECOMMENDATIONS_STORAGE_ENABLED=true

# Optional remote ad configuration (JSON with { "campaigns": [...] })
# ADS_CONFIG_URL=

# YouTube Data API (server-only — do not use NEXT_PUBLIC_)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_UPLOADS_PLAYLIST_ID=

# Meta Graph API — Facebook Page posts (server-only)
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_PAGE_ACCESS_TOKEN=

# Meta Graph API — Instagram media (server-only)
META_INSTAGRAM_USER_ID=
META_INSTAGRAM_ACCESS_TOKEN=

# Add Slice 'n' Story source photo to public/ads/slice-n-story-source.jpg then run:
# npm run ads:generate

# Seasonal national-day campaign banner.
# Date windows use Asia/Karachi (see src/lib/seasonal-campaigns.ts).
# Defence Day 2026: 2026-09-01 → 2026-09-07. Independence Day: 2026-08-10 → 2026-08-16.
# SEASONAL_CAMPAIGN_ENABLED=true
# Force a campaign for QA (bypasses dates): defence-day | independence-day
# SEASONAL_CAMPAIGN_FORCE=defence-day
# Legacy Independence Day kill-switch (still honoured for that campaign only):
# INDEPENDENCE_DAY_BANNER_ENABLED=false

# Search Console / Bing verification tokens (optional — do not invent values)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (optional — do not invent)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional production snapshot storage adapters (KV / Blob / Postgres) — wire in content-repository.ts
